{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lewis-software",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-29",
  "routes": [{ "pattern": "lewis.software", "custom_domain": true }],
  "assets": {
    "directory": "build/jaspr",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/contact"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "dan@lewis.software",
      "allowed_sender_addresses": ["contact@lewis.software"]
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
